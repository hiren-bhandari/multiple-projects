# Create an app at https://developer.linkedin.com/ and copy these values.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match an Authorized redirect URL in the app settings.
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
# LinkedIn REST API version header (YYYYMM). Update if LinkedIn sunsets it.
LINKEDIN_VERSION=202511
# Analytics targets (numeric IDs, comma separated)
LINKEDIN_AD_ACCOUNT_IDS=
LINKEDIN_ORG_IDS=
